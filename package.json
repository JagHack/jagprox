{
  "name": "jagprox-launcher",
  "version": "2.6.1",
  "description": "Launcher for JagProx",
  "main": "launcher/launcher.js",
  "scripts": {
    "start": "electron .",
    "launcher": "electron .",
    "build": "electron-builder",
    "test": "node --test",
    "lint": "eslint ."
  },
  "author": "JagHack",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-log": "^5.1.4",
    "electron-updater": "^6.8.9",
    "minecraft-protocol": "^1.47.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.4.1"
  },
  "build": {
    "extraResources": [
      {
        "from": "server-icon.png",
        "to": "server-icon.png"
      }
    ],
    "appId": "com.jaghack.jagprox",
    "productName": "JagProx",
    "artifactName": "JagProx-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "proxy.js",
      "formatter.js",
      "aliasManager.js",
      "config.yml",
      "aliases.json",
      "server-icon.png",
      "launcher/**/*",
      "modules/**/*",
      "utils/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "launcher/icon.png",
      "category": "Game"
    },
    "win": {
      "target": "nsis",
      "icon": "launcher/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "jaghack",
      "repo": "jagprox"
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "externalBin": [
      "binaries/jagprox"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/jagprox/package": "packaging/package-deb"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/jagprox/package": "packaging/package-rpm"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE"
    }
  }
}

# Maintainer: JagHack <jaghack@jaghack.com>
# Generated by .github/workflows/release-rust.yml from packaging/aur/PKGBUILD.in
pkgname=jagprox-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Hypixel proxy with in-game stats, and the jagprox command"
arch=('x86_64' 'aarch64')
url="https://github.com/JagHack/jagprox"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme')
provides=('jagprox')
conflicts=('jagprox')
options=('!strip' '!debug')
source_x86_64=("https://github.com/JagHack/jagprox/releases/download/v@VERSION@/jagprox_@VERSION@_amd64.deb")
source_aarch64=("https://github.com/JagHack/jagprox/releases/download/v@VERSION@/jagprox_@VERSION@_arm64.deb")
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"
  # Tells `jagprox update` to leave updates to the AUR helper.
  echo aur > "$pkgdir/usr/lib/jagprox/package"
}
